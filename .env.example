# Copy this file to .env at the repository root, then fill in your local values.
# The actual .env file is ignored by Git and must never be committed.

# SQL Server connection settings for BookHub.
# Optional Desktop SQL Server settings. The Desktop app can also use OS environment variables.
BOOKHUB_SQL_SERVER=localhost\\MSSQLSERVER01
BOOKHUB_SQL_DATABASE=CSDLTEST
BOOKHUB_SQL_DRIVER=ODBC Driver 18 for SQL Server
BOOKHUB_SQL_ENCRYPT=yes

# For local SQL Server instances with self-signed certificates, yes is convenient.
# In production use a trusted SQL certificate and set the trust option to no.
BOOKHUB_TRUST_SERVER_CERTIFICATE=yes

# Web Backend configuration. The Backend automatically loads this file from the project root.
# Use a dedicated SQL service account; never use employee passwords.
BOOKHUB_WEB_ENV=development
BOOKHUB_WEB_API_PREFIX=/api/v1
BOOKHUB_WEB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BOOKHUB_WEB_DOCS_ENABLED=true

# Backend launcher settings (used by: python run_backend.py).
BOOKHUB_WEB_HOST=127.0.0.1
BOOKHUB_WEB_PORT=8000
BOOKHUB_WEB_RELOAD=true
BOOKHUB_WEB_LOG_LEVEL=info

# Configure a dedicated SQL Server login for the Backend with least privilege.
BOOKHUB_WEB_SQL_SERVER=localhost\MSSQLSERVER01
BOOKHUB_WEB_SQL_DATABASE=CSDLTEST
BOOKHUB_WEB_SQL_DRIVER=ODBC Driver 18 for SQL Server
BOOKHUB_WEB_SQL_USERNAME=bookhub_web_app
BOOKHUB_WEB_SQL_PASSWORD=
BOOKHUB_WEB_SQL_ENCRYPT=yes
BOOKHUB_WEB_SQL_TRUST_SERVER_CERTIFICATE=yes
BOOKHUB_WEB_SQL_TIMEOUT_SECONDS=5
